# ============================================================
# RAILWAY ULTRA-CONSERVATIVE MODE
# Perfect for: Railway Free/Hobby tier, resource-constrained environments
# ============================================================

# ============================================================
# ADOBE TARGET VALIDATION - SEQUENTIAL MODE
# Process one URL at a time for maximum reliability
# ============================================================
ADOBE_VALIDATION_BATCH_SIZE=1                   # One URL per chunk
ADOBE_VALIDATION_CONCURRENT=1                   # One browser at a time
ADOBE_VALIDATION_MAX_TABS=1                     # One tab per browser (sequential)
ADOBE_VALIDATION_MAX_PAGES_BEFORE_RESTART=3     # Restart browser every 3 pages (Railway critical!)
RESTART_BROWSER_EVERY_N_CHUNKS=5                # Health check every 5 chunks
CHUNK_PROCESSING_TIMEOUT=0                      # Disabled (health checks work well)
# Note: Set to 180000 (3 min) if you want chunk timeout protection

# ============================================================
# BROWSER POOL CONFIGURATION
# Single browser, maximum timeouts
# ============================================================
BROWSER_POOL_SIZE=1                  # Single browser instance
PROTOCOL_TIMEOUT=90000               # 90 seconds (Railway CPUs are slow)
LAUNCH_TIMEOUT=45000                 # 45 seconds for browser startup
PAGE_CREATION_TIMEOUT=45000          # 45 seconds for page creation
QUEUE_TIMEOUT=60000                  # 60 seconds queue wait

# ============================================================
# NAVIGATION & SCRAPING TIMEOUTS
# Extra time for Railway's throttled CPUs
# ============================================================
PAGE_NAVIGATION_TIMEOUT=45000        # 45 seconds for page load
PAGE_SCRAPE_TIMEOUT=40000            # 40 seconds total extraction time
OVERALL_SCRAPE_TIMEOUT=50000         # 50 seconds overall timeout

# ============================================================
# RESOURCE MANAGEMENT
# Restart browser frequently, conserve memory
# ============================================================
MAX_PAGES_BEFORE_RESTART=10          # Restart every 10 pages
MEMORY_THRESHOLD_PERCENT=70          # Conservative memory threshold
PAGE_CREATION_RETRIES=3              # More retries for slow CPUs

# ============================================================
# ENVIRONMENT
# ============================================================
NODE_ENV=production

# ============================================================
# EXPECTED PERFORMANCE
# ============================================================
# 68 URLs: ~15-20 minutes
# Success Rate: 95%+
# Resource Usage: Minimal (perfect for Railway free tier)
#
# Logs will show:
# 📊 Adobe Target Validation Configuration:
#    Batch Size: 1 URLs per chunk
#    Concurrent Browsers: 1
#    Max Tabs per Browser: 1
#    Total Batches: 68
# ============================================================

