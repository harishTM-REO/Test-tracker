# ============================================
# ADOBE TARGET 1.0 WORKFLOW TIMEOUTS
# ============================================
# Configure timeouts for each step of the Adobe Target 1.0 workflow
# All values are in milliseconds

# Step 1: URL Prioritization Timeout
# This includes live-crawling the page and prioritizing collected URLs
# Default: 180000ms (3 minutes)
PRIORITIZATION_TIMEOUT=180000

# Step 2: URL Categorization Timeout
# This includes categorizing prioritized URLs and selecting top 25
# Default: 120000ms (2 minutes)
CATEGORIZATION_TIMEOUT=120000

# ============================================
# BROWSER CLEANUP ON TIMEOUT
# ============================================
# When a timeout occurs, should we restart all browsers to free memory?
# Default: true (recommended for production)
# Set to 'false' to disable browser restart on timeout
RESTART_BROWSER_ON_TIMEOUT=true

# ============================================
# USAGE EXAMPLES
# ============================================

# Reduce timeouts for faster processing (but may skip slow pages)
# PRIORITIZATION_TIMEOUT=60000    # 1 minute
# CATEGORIZATION_TIMEOUT=30000    # 30 seconds

# Increase timeouts for slow/complex websites
# PRIORITIZATION_TIMEOUT=300000   # 5 minutes
# CATEGORIZATION_TIMEOUT=180000   # 3 minutes

# ============================================
# RECOMMENDATIONS
# ============================================
# - For e-commerce sites with many products: Use higher timeouts (5+ minutes)
# - For simple/fast sites: Use lower timeouts (1-2 minutes)
# - If you see "Prioritization timeout" errors frequently, increase PRIORITIZATION_TIMEOUT
# - If you see "Categorization timeout" errors frequently, increase CATEGORIZATION_TIMEOUT
# - Keep RESTART_BROWSER_ON_TIMEOUT=true to prevent memory leaks from stuck browsers

# ============================================
# ENABLE GARBAGE COLLECTION (OPTIONAL)
# ============================================
# To enable forced garbage collection on timeout, start your Node.js process with:
#
# Railway/Production:
# Add to Procfile or start command: node --expose-gc server.js
#
# Local Development:
# npm start -- --expose-gc
# OR
# node --expose-gc server.js
#
# This allows the code to call global.gc() to free memory immediately after timeout
