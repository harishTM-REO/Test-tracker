# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Optimized for large datasets (50,000+ URLs) with high concurrency
# ============================================================================

# ============================================================================
# SERVER & API ENDPOINTS (PRODUCTION)
# ============================================================================
NODE_ENV=production
API_BASE_URL=https://test-tracker-production.up.railway.app
BACKEND_URL=https://test-tracker-production.up.railway.app
FRONTEND_URL=https://test-tracker-frontend-production.up.railway.app
CORS_ORIGIN=https://test-tracker-frontend-production.up.railway.app

# Worker Service URLs
WORKER_ABTASTY_PORT=4002
WORKER_ABTASTY_URL=4002
WORKER_AT10_PORT=https://test-tracker-at-production.up.railway.app
WORKER_AT10_URL=https://test-tracker-at-production.up.railway.app

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
MONGODB_URI=mongodb://mongo:pDfaYtFEDPXANoIKQKSYdCBNvVFEqUbf@yamabiko.proxy.rlwy.net:13101
MONGODB_MAX_POOL_SIZE=30
MONGODB_MIN_POOL_SIZE=5
MONGODB_SOCKET_TIMEOUT=90000
MONGODB_CONNECTION_TIMEOUT=45000
DB_RECONNECT_ATTEMPTS=7
DB_RECONNECT_DELAY=3000

# ============================================================================
# JOB QUEUE TIMEOUTS - NEW: Configured for 50,000+ URL datasets
# ============================================================================
# Worker execution timeout: Maximum time a worker can run before being killed
# For 50k URLs with 7 concurrent browsers: ~30-40 hours processing time + buffer
WORKER_EXECUTION_TIMEOUT_HOURS=72

# Job timeout: When to mark running jobs as "stuck" and fail them
# Should match or slightly exceed worker timeout
JOB_TIMEOUT_HOURS=72

# Job cleanup interval: How often to check for stuck/old jobs (in minutes)
# Runs every 2.5 hours to check for jobs exceeding JOB_TIMEOUT_HOURS
JOB_CLEANUP_INTERVAL_MINUTES=150

# ============================================================================
# BROWSER & PAGE TIMEOUTS (per-operation, not for entire job)
# ============================================================================
# Browser launch and creation
LAUNCH_TIMEOUT=120000
PAGE_CREATION_TIMEOUT=15000
PAGE_NAVIGATION_TIMEOUT=15000
PAGE_SCRAPE_TIMEOUT=30000
OVERALL_SCRAPE_TIMEOUT=45000

# Protocol and queue timeouts
PROTOCOL_TIMEOUT=240000
QUEUE_TIMEOUT=90000
BROWSER_CLOSE_TIMEOUT=15000

# NEW: Browser acquisition timeout - Prevents deadlock if all browsers are stuck
# This is critical for preventing infinite hangs (NOT for entire job duration)
BROWSER_ACQUIRE_TIMEOUT=300000

# Chunk processing timeout
CHUNK_PROCESSING_TIMEOUT=0

# ============================================================================
# BROWSER POOL CONFIGURATION - High Performance (7 browsers)
# ============================================================================
# Browser Service Selection
USE_PLAYWRIGHT=true
USE_PUPPETEER_CLUSTER=false

# Browser pool size: Number of concurrent browser instances
BROWSER_POOL_SIZE=7
PLAYWRIGHT_POOL_SIZE=7
MAX_BROWSERS=2

# Browser restart frequency: Restart browser after N pages to prevent memory leaks
# For 50k URLs with batch size 25: 2,000 batches total
# With 7 browsers processing concurrently, ~286 batches per browser
# Restart every 100 pages maintains stability
BROWSER_RESTART_EVERY=25
MAX_PAGES_BEFORE_RESTART=50
PLAYWRIGHT_MAX_PAGES_BEFORE_RESTART=100
POOL_REFRESH_AFTER_URLS=20
POOL_REFRESH_AFTER_MINUTES=0
RESTART_BROWSER_EVERY_N_CHUNKS=3
BROWSER_LAUNCH_STAGGER_MS=5000
BROWSER_RESTART_MEMORY_DELAY_MS=10000

# Puppeteer Cluster Configuration (legacy - not used when USE_PLAYWRIGHT=true)
CLUSTER_CONCURRENCY_MODEL=BROWSER
CLUSTER_MAX_JOBS_PER_BROWSER=50
CLUSTER_WORKER_CREATION_DELAY=2000

# ============================================================================
# BATCH PROCESSING CONFIGURATION - High Concurrency
# ============================================================================
# Batch size: How many URLs to process before saving/memory cleanup
BATCH_SIZE=25
BATCH_DELAY=2000

# Concurrency: How many URLs to process simultaneously
# With 7 browsers, you can handle higher concurrency
CONCURRENT_URLS=7
PQUEUE_CONCURRENCY=7

# NEW: Intermediate save interval - Save results every N batches
# With BATCH_SIZE=25, save every 3 batches = every 75 URLs
# For 50k URLs: ~667 save points (excellent data protection!)
ABTASTY_SAVE_INTERVAL=3

# Checkpoint configuration
CHECKPOINT_ENABLED=true
CHECKPOINT_INTERVAL=200
CHECKPOINT_DIR=./backend/checkpoints
SAFE_BATCH_PROCESSING=true

# ============================================================================
# ADOBE TARGET / OPTIMIZELY SPECIFIC SETTINGS
# ============================================================================
ADOBE_SCRAPING_BROWSER_POOL_SIZE=2
ADOBE_SCRAPING_CONCURRENT=3
ADOBE_VALIDATION_BATCH_SIZE=25
ADOBE_VALIDATION_CONCURRENT=2
ADOBE_VALIDATION_MAX_PAGES_BEFORE_RESTART=3
ADOBE_VALIDATION_MAX_TABS=3

# ============================================================================
# MEMORY MANAGEMENT - Production Server (8GB Node.js)
# ============================================================================
# Node.js memory limits
NODEJS_MEMORY_LIMIT=8000
NODE_OPTIONS=--expose-gc --max-old-space-size=7000

# Memory monitoring and cleanup
ENABLE_MEMORY_MONITORING=true
MEMORY_THRESHOLD_PERCENT=75
MEMORY_THRESHOLD_MB=3000
MEMORY_CLEANUP_INTERVAL=15000
FORCE_GC_INTERVAL=20000
MAX_MEMORY_PER_BROWSER=400

# ============================================================================
# BROWSER HEALTH & RELIABILITY
# ============================================================================
ENABLE_BROWSER_HEALTH_CHECK=true
BROWSER_HEALTH_CHECK_INTERVAL=45000
MAX_BROWSER_AGE_MINUTES=90
BROWSER_CRASH_RECOVERY_ATTEMPTS=5

# ============================================================================
# NETWORK & RETRY CONFIGURATION
# ============================================================================
ENABLE_NETWORK_RETRY=true
MAX_NETWORK_RETRIES=3
NETWORK_RETRY_DELAY=4000
NETWORK_TIMEOUT_THRESHOLD=30000
PUPPETEER_DISABLE_HTTP2=1

# ============================================================================
# FILE UPLOAD LIMITS
# ============================================================================
# NEW: Maximum upload file size in MB (for dataset XLSX uploads)
# 100MB supports ~200,000 URLs with metadata columns
MAX_UPLOAD_SIZE_MB=100

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================
BROWSERLESS_API_TOKEN=2SjBLyg7WyPbQLTab3c5738c070c6bdc8c45c1dd2351b500d
LOCAL_CHROME_PATH=/usr/bin/chromium

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
EMAIL_FROM=noreply@yourapp.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com

# ============================================================================
# MISCELLANEOUS
# ============================================================================
TIME_OUT_TIME=2700000
TRIGGER=falsee
