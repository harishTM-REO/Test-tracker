# Adobe Target 1.0 Worker Service Configuration

# Server Port
WORKER_AT10_PORT=4001

# Backend Services
BACKEND_URL=http://localhost:3000
# In production: BACKEND_URL=https://your-main-backend.railway.app

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
# In production: CORS_ORIGIN=https://your-frontend.railway.app

# Adobe Target 1.0 Specific Settings
# Concurrency for scraping top 25 URLs per original URL
AT10_CONCURRENCY=4

# URL Collector Service (if different from main backend)
# URL_COLLECTOR_BASE_URL=http://localhost:3000/api/url-collector

# Logging
LOG_LEVEL=debug
# In production: LOG_LEVEL=info

# Node Environment
NODE_ENV=development
# In production: NODE_ENV=production

# Optional: Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
